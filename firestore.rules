rules_version = '2';

// Capy — Cloud Firestore security rules
// Project: capy-app-unbanned
//
// Data model — everything lives under a per-user subtree:
//   users/{uid}/profile/main
//   users/{uid}/pet/main
//   users/{uid}/sessions/{id}
//   users/{uid}/commitments/{id}
//   users/{uid}/starts/{id}        first-step flow (/start)
//
// Only the signed-in owner may touch their own subtree. Anonymous (guest)
// users ARE authenticated, so request.auth != null holds for them too.
// There is no cross-user or public access. Anything not matched is denied.
//
// NOTE: this is NOT a time-limited "test mode" rule — it has no expiry.
// Deploy with:  firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    // The owner may read/write anything under their own users/{uid} subtree.
    // The recursive {document=**} covers profile/main, pet/main, and the
    // sessions/{id} and commitments/{id} subcollections in one rule.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Everything else: default-deny.
  }
}
